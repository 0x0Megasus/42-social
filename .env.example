# Copy to .env.local and fill in. Never commit .env.local.
FIREBASE_DATABASE_URL=https://<project>.firebaseio.com
FIREBASE_CLIENT_EMAIL=<service-account-email>
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
AUTH_SECRET=<long-random-string>

# 42 OAuth (Intra)
FORTYTWO_CLIENT_ID=<id>
FORTYTWO_CLIENT_SECRET=<secret>

# Google OAuth
GOOGLE_CLIENT_ID=<id>
GOOGLE_CLIENT_SECRET=<secret>

# Site owner/support allowlist (comma-separated emails, 42 logins, or user
# ids). Matched server-side only — never exposed to the browser.
# Example: SUPPORT_IDENTIFIERS="you@gmail.com, your42login"
SUPPORT_IDENTIFIERS=""

# Public site URL (metadata only)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
